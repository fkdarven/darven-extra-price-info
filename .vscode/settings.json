{
	// Diretórios a serem ignorados nas validações
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/*/**": true,
		"**/.hg/store/**": true,
		"**/vendor/*/**": true,
	},
	"files.exclude": {
		"**/.classpath": true,
		"**/.project": true,
		"**/.settings": true,
		"**/.factorypath": true
	},
	// Configurações PHP
	"phpSniffer.standard": "./phpcs.xml",
	"phpSniffer.autoDetect": true,
	"[php]": {
		"editor.defaultFormatter": "wongjn.php-sniffer",
		"editor.formatOnSave": true
	},
}
