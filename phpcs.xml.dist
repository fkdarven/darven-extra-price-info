<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Darven Extra Price Info">
	<description>
		WordPress quality and security checks adapted for the plugin's PSR-4 source
		and PHPUnit unit tests.
	</description>

	<arg name="basepath" value="./"/>
	<arg name="extensions" value="php"/>

	<file>src</file>
	<file>tests</file>

	<!-- Global WordPress doubles are test infrastructure, not production or unit-test code. -->
	<exclude-pattern>*/tests/bootstrap\.php$</exclude-pattern>

	<!-- Mixed line endings are pre-existing test-file formatting and are deferred with the style cleanup. -->
	<rule ref="Internal.LineEndings.Mixed">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress">
		<!-- PSR-4 classes and PHPUnit test method names deliberately differ from WPCS file/method naming. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>

		<!-- The current migration baseline does not require legacy-style docblocks. -->
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.VariableComment"/>

		<!-- Formatting and test-double-only structure are intentionally deferred from this refactor. -->
		<exclude name="Generic.Classes.OpeningBraceSameLine"/>
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
		<exclude name="Generic.Files.LineEndings"/>
		<exclude name="Generic.Files.OneObjectStructurePerFile"/>
		<exclude name="Generic.Formatting.DisallowMultipleStatements"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="PSR2.Classes.ClassDeclaration"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
		<exclude name="Squiz.WhiteSpace.SuperfluousWhitespace"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
		<exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
		<exclude name="Universal.WhiteSpace.CommaSpacing"/>
		<exclude name="Universal.WhiteSpace.DisallowInlineTabs"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.Arrays.ArrayIndentation"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>

		<!-- Sanitized GET values select assets only; mutating requests still require nonce verification. -->
		<exclude name="WordPress.Security.NonceVerification.Recommended"/>
	</rule>

	<rule ref="WordPress.WP.AlternativeFunctions">
		<!-- Tests read fixture assets directly; production code remains covered by this sniff. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
